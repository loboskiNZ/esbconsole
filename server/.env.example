APP_NAME="Band Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://band.edandtheshadowboys.com
APP_TIMEZONE=UTC

PORTAL_BAND_ID=1
PORTAL_LIBRARY_CONNECTION=library
PORTAL_LIBRARY_CHART_DISK=library
# Absolute path to private chart PDF root on Forge shared storage (not public web root)
PORTAL_LIBRARY_STORAGE_ROOT=/home/forge/band.edandtheshadowboys.com/storage/app/library

# Studio library DB (defaults to portal DB_* when unset)
LIBRARY_DB_HOST=
LIBRARY_DB_PORT=
LIBRARY_DB_DATABASE=
LIBRARY_DB_USERNAME=
LIBRARY_DB_PASSWORD=
LIBRARY_DB_SSLMODE=

# Library sync source (Director/master library — used by: php artisan studio:library-sync)
LIBRARY_SYNC_SOURCE_HOST=127.0.0.1
LIBRARY_SYNC_SOURCE_PORT=5432
LIBRARY_SYNC_SOURCE_DATABASE=esb_dev
LIBRARY_SYNC_SOURCE_USERNAME=esb
LIBRARY_SYNC_SOURCE_PASSWORD=
LIBRARY_SYNC_SOURCE_SSLMODE=prefer

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# PostgreSQL 16+ (DigitalOcean Managed PostgreSQL via Forge)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=band_portal
DB_USERNAME=band_portal
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@edandtheshadowboys.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
